# =============================================================================
# DERMA-AI Production Environment Variables
# Copy this file to `.env` in this folder (derma/) before running:
#   docker compose -f docker-compose.prod.yml up -d --build
# =============================================================================

# Database Credentials
DB_PASSWORD=replace_with_strong_db_password_min_16_chars

# Redis
REDIS_URL=redis://redis:6379

# MinIO / Object Storage Credentials
MINIO_ROOT_USER=derma_ai_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password_min_16_chars

# JWT Security Secrets (Must be at least 32 characters, cryptographically random)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_generated_random_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_generated_random_refresh_secret_at_least_32_chars

# URLs and Domains
# Frontend URL(s) allowed for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-domain.com

# Public API Gateway URL accessed by client browsers
API_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=https://your-domain.com

# Node Environment
NODE_ENV=production
